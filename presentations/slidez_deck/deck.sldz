// Slidez — a deck about Slidez, written in Slidez, styled by its own plugin.
// Every feature of the language and plugin system shows up somewhere here.

Slides:
    Font: Montserrat
    Size: 24
    Color: "#E8ECEF"

// ---------------------------------------------------------------- 1 · title

SlidezTitleSlide:
    Image: "media/logo.png"
        Position: [0.07, 0.38]
        Size: [0.15, 0.15]

    Text: "Slidez"
        Role: title
        Font: Manrope
        Bold: true

    Text: "presentations as code — a tiny language that compiles to one portable PDF"
        Role: subtitle

    Text: "no browser, no HTML/CSS, no toolchain — read the whole core in an afternoon"
        Role: company
        Color: "#9AA7B0"

// ----------------------------------------------------------------- 2 · why

SlidezSlide:
    Title: "Why Slidez"

    Bullets:
        MarkerColor: "#4CC38A"
        Existing tools pull you in two directions
            GUI decks (PowerPoint, Keynote, Google Slides) are opaque blobs
            they diff poorly, merge worse, and rot in attachments
            HTML decks (reveal.js, Slidev, Marp) need a browser and a toolchain
        Slidez goes minimal on purpose
            **one** plain-text file in
            **one** portable PDF out — opens and prints anywhere
            a Python core **small enough to clone, skim and fork**

// ---------------------------------------------------------------- 3 · field

SlidezTwoColumns:
    Title: "The field"

    Text: "How decks get made today:"
        Column: 0
        Size: 26

    Bullets:
        Column: 0
        PowerPoint / Keynote — GUI, binary formats
        Google Slides — GUI, lives in someone else's cloud
        Marp / Slidev — Markdown, but ship an HTML runtime
        reveal.js — a web app that happens to show slides
        Beamer — PDF-native, but it is LaTeX

    Text: "Where Slidez sits:"
        Column: 1
        Size: 26

    Bullets:
        Column: 1
        text-first, like Marp
        PDF-native, like Beamer
        extensible in plain Python, unlike either
        the compiler is meant to be read, not installed and feared

// ------------------------------------------------------------ 4 · language

SlidezTwoColumns:
    Title: "The language (.sldz)"

    Bullets:
        Column: 0
        YAML-ish, but no dashes and no YAML edge cases
        indentation is the structure
        bare lines are text; deeper lines nest
        comments: "//" for lines, "/* */" for blocks

    Code: "Slides:\n    Font: Manrope\n\nWhySlide:\n    Title: Why Slidez\n    Bullets:\n        one text file in\n        one portable PDF out\n            opens anywhere\n"
        Column: 1
        Size: 14.5
        Fill: "#131A21"

// -------------------------------------------------------- 5 · value syntax

SlidezSlide:
    Title: "Values, properties, spans"

    Bullets:
        ItemGap: 8
        Numbers:  Size: 48 — floats welcome
        Booleans: Bold: true
        Lists: Position: [0.5, 0.5]
        Colors: "#61AFEF", or named — like white
        PascalCase keys map to snake_case attributes
            Position -> position, BorderColor -> border_color
        **bold spans** inside any text — **like these**
        Position and Size are fractions of the slide, not pixels
            what you see is what any projector gets

